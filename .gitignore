# secrets
.env

# python envs
.venv/
.venv_live2d/
__pycache__/
*.pyc

# OS
.DS_Store

# node (unrelated VRM proof-of-concept under scripts/test/vrm-poc)
node_modules/
scripts/test/vrm-poc/output/

# model binaries (large, downloadable, not source deliverables)
*.task
yolo11n-pose.pt

# downloaded ZHO clips/thumbs (large, re-downloadable via scripts/zho_download.py)
data/zho/clips/
data/zho/thumbs/

# large generated/experimental media (reproducible via scripts, not source)
# EXCEPTION: lesson_captioned_xfade.mp4 is the known-working baseline video,
# kept as checkpoint evidence (see CHECKPOINT.md) - explicitly un-ignored below.
data/zho/spike_mediapipe/*.mp4
data/zho/spike_mediapipe/trimmed/
data/zho/spike_mediapipe/lesson/*
!data/zho/spike_mediapipe/lesson/lesson_captioned_xfade.mp4
data/zho/spike_mediapipe/rigged/
data/zho/spike_mediapipe/sentence/
data/zho/spike_mediapipe/paragraph/
data/zho/spike_mediapipe/normalized/
data/zho/spike_mediapipe/avatar_parts/*.png
data/zho/spike_mediapipe/avatar_parts/*.jpeg
scratch/*.html

# pipeline run outputs (generated, one dir per run - see outputs/README.md)
outputs/*/
!outputs/.gitkeep

# benchmark cache/scratch (keep results/, ignore nothing here currently - explicit allow below)
webapp/outputs/

# clip-prep cache (re-downloadable/re-derivable, not source)
data/zho/spike_mediapipe/norm_cache/
data/zho/spike_mediapipe/trim_cache.json

# optional embedding retrieval cache (reproducibly rebuildable via
# scripts/vocab_embedding_benchmark.py / lib/vocab_embedding_st.py -
# not source, and large - see catalog_bilingual_report.json for the
# evidence that IS kept as source)
data/zho/catalog_embeddings.json
data/zho/catalog_embeddings_*.npz

# ESL Zayed OCR pilot: raw downloaded videos and bulk extracted frames
# never committed (licensing + repo-size), only derived JSON/scripts kept
data/zho/spike_mediapipe/esl_zayed_caption_pilot_v2_20260823/videos/
data/zho/spike_mediapipe/esl_zayed_caption_pilot_v2_20260823/frames/
data/zho/spike_mediapipe/esl_zayed_caption_pilot_v2_20260823/ocr_frames/
data/zho/spike_mediapipe/esl_zayed_caption_pilot_v2_20260823/scale_frames/
data/zho/spike_mediapipe/esl_zayed_caption_pilot_v2_20260823/__pycache__/
